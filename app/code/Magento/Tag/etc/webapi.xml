<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/tags/:tagId" method="GET">
        <service class="Magento\Tag\Api\TagRepositoryInterface" method="getById"/>
        <resources>
            <resource ref="Magento_Tag::tag_all"/>
        </resources>
    </route>
    <route url="/V1/tags" method="GET">
        <service class="Magento\Tag\Api\TagRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="Magento_Tag::tag_all"/>
        </resources>
    </route>
    <route url="/V1/tags" method="POST">
        <service class="Magento\Tag\Api\TagRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Magento_Tag::tag_all"/>
        </resources>
    </route>
    <route url="/V1/tags/:tagId" method="PUT">
        <service class="Magento\Tag\Api\TagRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Magento_Tag::tag_all"/>
        </resources>
    </route>
    <route url="/V1/tags/:tagId" method="DELETE">
        <service class="Magento\Tag\Api\TagRepositoryInterface" method="deleteById"/>
        <resources>
            <resource ref="Magento_Tag::tag_all"/>
        </resources>
    </route>
    <route url="/V1/products/:productId/tags" method="POST">
        <service class="Magento\Tag\Api\TagManagementInterface" method="addTagsToProduct"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
</routes>
